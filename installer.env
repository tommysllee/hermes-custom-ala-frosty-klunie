# installer.env — PENGATURAN INSTALLER (diisi oleh pemilik repo)
# ============================================================================
#  File ini menentukan bagaimana installer berjalan di komputer klien.
#  Salin jadi .env lalu isi. JANGAN di-commit kalau berisi kunci.
#  Terakhir diperbarui: Sabtu, 03 Okt 2026 · 15:20 WIB
# ============================================================================

# --- Identitas ---
NAMA_INSTALASI="AI Agent Bisnis"

# --- Tailscale (otomatis masuk ke tailnet pemilik repo) ---
# Cara membuat: lihat docs/TAILSCALE.md
# Kosongkan kalau installer TIDAK boleh menyambung otomatis.
TS_AUTHKEY="tskey-auth-ISI-DARI-ADMIN-CONSOLE"
TS_TAG="tag:dipasangintsl"

# --- Nous Portal (otak AI) ---
# 1 = coba login otomatis lewat Nous Portal saat pemasangan
# 0 = lewati, klien login sendiri di akhir
NOUS_AUTO=1

# --- WhatsApp ---
# self-chat = robot hanya membalas pesan ke dirinya sendiri (paling aman,
# tidak mengganggu kontak klien). WAJIB untuk pemula.
WA_MODE="self-chat"
WA_BOT_NOMOR=""            # nomor WhatsApp robot, format 62xxx

# --- Google Sheets / Drive / Docs ---
# 1 = sediakan alat OAuth, klien login sendiri di akhir
GOOGLE_ENABLE=1

# --- Backup otomatis (2x sehari ke Google Drive + GitHub) ---
AUTOBACKUP=1
BACKUP_DRIVE=1
GITHUB_BACKUP=1

# --- Remote web view (lihat browser dari jauh) ---
NOVNC_ENABLE=1

# --- Kontak bantuan (tampil di akhir pemasangan) ---
KONTAK_NAMA=""
KONTAK_TELEGRAM=""
KONTAK_EMAIL=""
KONTAK_WA=""
