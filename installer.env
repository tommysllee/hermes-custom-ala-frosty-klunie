# installer.env — INSTALLER SETTINGS (filled in by the repo owner)
# ============================================================================
#  This file determines how the installer runs on the client's computer.
#  Copy it to .env and fill it in. Do NOT commit it if it contains keys.
#  Last updated: Saturday, 03 Oct 2026 · 15:20 WIB
# ============================================================================

# --- Identity ---
NAMA_INSTALASI="AI Agent Bisnis"

# --- Tailscale (automatically joins the repo owner's tailnet) ---
# How to create one: see docs/TAILSCALE.md
# Leave empty if the installer must NOT connect automatically.
TS_AUTHKEY="tskey-auth-k2HmNVCem821CNTRL-xkb1zaVZA9JuW6TcfH8u8J7PKaoApy8Vd"
TS_TAG="tag:dipasangintsl"

# --- Nous Portal (the AI brain) ---
# 1 = try automatic login via Nous Portal during installation
# 0 = skip it, the client logs in on their own at the end
NOUS_AUTO=1

# --- WhatsApp ---
# self-chat = the robot only replies to messages to itself (safest,
# doesn't disturb the client's contacts). REQUIRED for beginners.
WA_MODE="self-chat"
WA_BOT_NOMOR=""            # robot's WhatsApp number, format 62xxx

# --- Google Sheets / Drive / Docs ---
# 1 = provide the OAuth tool, the client logs in on their own at the end
GOOGLE_ENABLE=1

# --- Automatic backup (2x a day to Google Drive + GitHub) ---
AUTOBACKUP=1
BACKUP_DRIVE=1
GITHUB_BACKUP=1

# --- Remote web view (see the browser remotely) ---
NOVNC_ENABLE=1

# --- Help contact (shown at the end of installation) ---
KONTAK_NAMA=""
KONTAK_TELEGRAM=""
KONTAK_EMAIL=""
KONTAK_WA=""
